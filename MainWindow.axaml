<Window
    x:Class="YT2MP3Sharp.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="YT2MP3Sharp"
    Width="800"
    Height="540"
    MinWidth="640"
    MinHeight="380"
    d:DesignHeight="540"
    d:DesignWidth="800"
    Background="#1D1616"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

        <!--  Link + main actions  -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="UrlTxt"
                Grid.Column="0"
                VerticalContentAlignment="Center"
                FontSize="14"
                PlaceholderText="Paste a YouTube video or playlist link" />
            <Button
                x:Name="DownloadBtn"
                Grid.Column="1"
                MinWidth="110"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="accent"
                Click="DownloadBtn_Click"
                Content="Download" />
            <Button
                x:Name="CancelBtn"
                Grid.Column="2"
                MinWidth="90"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="CancelBtn_Click"
                Content="Cancel"
                IsVisible="False" />
        </Grid>

        <!--  Format, quality and save folder  -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <ComboBox
                x:Name="Formatbox"
                Grid.Column="0"
                MinWidth="100"
                ToolTip.Tip="Output format">
                <ComboBoxItem>MP3</ComboBoxItem>
                <ComboBoxItem>MP4</ComboBoxItem>
            </ComboBox>
            <ComboBox
                x:Name="Qualitybox"
                Grid.Column="1"
                MinWidth="140"
                IsEnabled="False"
                PlaceholderText="Best quality"
                ToolTip.Tip="Video quality (single MP4 downloads)" />
            <TextBlock
                x:Name="Spath"
                Grid.Column="2"
                Margin="8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="#EEEEEE"
                Opacity="0.8"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="SelectFolderBtn"
                Grid.Column="3"
                MinWidth="90"
                HorizontalContentAlignment="Center"
                Click="SelectFolderButton_Click"
                Content="Save to..." />
        </Grid>

        <!--  Log: read-only, but it can be scrolled, selected and copied  -->
        <TextBox
            x:Name="Logpane"
            Grid.Row="2"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontSize="13"
            IsReadOnly="True"
            TextWrapping="Wrap" />

        <!--  Progress  -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ProgressBar
                x:Name="Progressbar"
                Grid.Column="0"
                Height="6"
                VerticalAlignment="Center"
                Foreground="#D84040"
                Maximum="100"
                Minimum="0"
                Value="0" />
            <TextBlock
                x:Name="StatusTxt"
                Grid.Column="1"
                MinWidth="80"
                VerticalAlignment="Center"
                Foreground="#EEEEEE"
                Opacity="0.8"
                TextAlignment="Right" />
        </Grid>
    </Grid>
</Window>
